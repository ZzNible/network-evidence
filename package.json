{
  "name": "nec-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo:core-hub-lens": "tsx examples/core-hub-lens/run.ts",
    "maps:serve": "node examples/ne-maps/serve.mjs",
    "test:maps": "vitest run examples/ne-maps/test",
    "maps:collection": "tsx examples/ne-maps/build-collection.ts --verify",
    "demo:integrability": "tsx examples/integrability-fixture/run.ts --verify",
    "demo:historical-compat": "tsx examples/historical-compat/run.ts --verify",
    "demo:discovery": "tsx examples/discovery/run.ts",
    "mcp:serve": "tsx packages/mcp/src/cli.ts",
    "mcp:smoke": "tsx packages/mcp/test/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  }
}
